# Supabase — from Project Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never expose to the browser. Used by cron/API routes
# that need to bypass RLS (ingestion, enrichment writes).
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret Vercel Cron must send as `Authorization: Bearer <value>` when calling
# /api/cron/* routes, so those endpoints can't be triggered by random requests.
CRON_SECRET=

# Calgary Open Data (SODA API) — public dataset, no key required for light usage.
# Get a free app token at https://data.calgary.ca/profile/edit/developer_settings to
# raise the throttling limits before this goes into daily production use.
CALGARY_OPEN_DATA_APP_TOKEN=

# Hunter.io — used in Step 5 for contact/email enrichment.
HUNTER_API_KEY=

# Base URL used in magic-link login emails (Step 7). Set this explicitly in production
# (e.g. https://your-app.vercel.app) — without it, the URL is derived from the request's
# Host header, which is fine for a single deployment but fragile behind proxies/multiple
# domains. Also add "<this-url>/auth/callback" to Supabase's Authentication > URL
# Configuration > Redirect URLs allowlist, or login will fail with a redirect error.
NEXT_PUBLIC_SITE_URL=

# Resend (https://resend.com) — used in Step 9 for the daily new-leads email digest.
# Without RESEND_API_KEY, the digest cron still runs and computes the content, it just
# doesn't send — safe to leave unset until you're ready to onboard a real team.
RESEND_API_KEY=
# Must be a verified sending domain in Resend, or their shared sandbox address
# "onboarding@resend.dev" for testing before you've verified one.
DIGEST_FROM_EMAIL=
